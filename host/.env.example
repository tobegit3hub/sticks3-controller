# Controller host-side config. Copy this file to `.env` (in the package
# root, next to ble_client.py) and fill in.

# --- ASR(云端语音转写)配置 ---
# 主机做云端语音转写,用 OpenAI 兼容的 /chat/completions 接口。
# 换供应商只需改这三个变量,不用改代码(任何兼容 chat/completions 的后端都行)。
# ASR_KEY 填你自己的真实 key(示例占位:sk-ws-xxx)
ASR_KEY="sk-ws-xxx"
ASR_BASE_URL=https://llm-twybn472bigenxpi.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ASR_MODEL=qwen3-asr-flash

# --- 文字清洗(可选) ---
# 对每段转写做轻量校对(删填充词、修错字、补标点)。
# 默认和 ASR 共用 ASR_KEY / ASR_BASE_URL;若清洗想走单独的 key/端点,
# 可配 CLEANUP_KEY、CLEANUP_BASE_URL(不配就用 ASR 的)。
# 不配置 CLEANUP_MODEL = 不清洗(换别的 API 没有 qwen-flash 也完全没问题)。
# 想清洗:取消注释,填你的文本模型名(如 qwen-flash)。
# 命令行加 --no-clean 可临时关闭。
# CLEANUP_MODEL=qwen-flash
# CLEANUP_KEY=
# CLEANUP_BASE_URL=

# --- Wake target (B long-press on the stick, control cmd=3) ---
# 长按 B 打开哪个 App:填 macOS 应用名(填什么就打开什么)。
LINKO_WAKE_APP=VSCode
